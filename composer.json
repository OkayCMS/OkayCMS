{
  "name": "okaycms/okaycms",
  "description": "OkayCMS",
  "homepage": "https://okay-cms.com",
  "license": "LGPL-3.0-or-later",
  "type": "project",
  "authors": [
    {
      "name": "Vitaliy Vladov",
      "email": "vitaliyvladov@gmail.com"
    },
    {
      "name": "Yanchuk Oleg",
      "email": "yanchuk.oleg2@gmail.com"
    },
    {
      "name": "Vavilin Aleksandr",
      "email": "synsvavilin@gmail.com"
    },
    {
      "name": "Hleb Vasylenko",
      "email": "glebvs93@gmail.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-SimpleXML": "*",
    "ext-XMLReader": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-iconv": "*",
    "ext-mbstring": "*",
    "ext-zip": "*",
    "ext-gd": "*",
    "smarty/smarty": "^5.0",
    "mobiledetect/mobiledetectlib": "^4.10",
    "phpmailer/phpmailer": "^7.0",
    "sabberworm/php-css-parser": "^9",
    "bramus/router": "~1.4",
    "psr/log": "^3.0",
    "monolog/monolog": "^3.0",
    "aura/sqlquery": "^3.0",
    "aura/sql": "^6.0",
    "giggsey/libphonenumber-for-php": "^9.0",
    "psr/container": "^2.0",
    "symfony/console": "^8.0",
    "dragonmantank/cron-expression": "^3.1",
    "symfony/process": "^8.0",
    "symfony/lock": "^8.0",
    "chillerlan/php-qrcode": "^6.0",
    "axy/sourcemap": "^1.1",
    "intervention/image": "^4.0",
    "openai-php/client": "^0.19",
    "guzzlehttp/guzzle": "^7.10",
    "wikimedia/minify": "^2.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.1",
    "php-debugbar/php-debugbar": "^3.0",
    "phpstan/phpstan": "~2.2.1",
    "rector/rector": "^2.4.2",
    "squizlabs/php_codesniffer": "^4.0",
    "symfony/var-dumper": "^8.0",
    "laravel/pao": "^1.1",
    "php-debugbar/monolog-bridge": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Okay\\": "Okay/",
      "Okay\\Admin\\": "backend/",
      "Snowplow\\RefererParser\\": "Okay/Core/UserReferer/Snowplow/RefererParser/"
    },
    "exclude-from-classmap": [
      "/backend/design/js/filemanager/",
      "/Okay/Modules/OkayCMS/Integration1C/Integration/Import/Overrides/ImportProductsExample.php"
    ]
  },
  "scripts": {
    "post-install-cmd": [
      "@php scripts/apply-patches.php"
    ],
    "post-update-cmd": [
      "@php scripts/apply-patches.php"
    ],
    "post-create-project-cmd": [
      "@php -r \"file_exists('./config/config.local.php') || copy('./config/config.php', './config/config.local.php');\"",
      "@php ok database:deploy --yes"
    ],
    "check:composer": "composer validate --strict",
    "security:audit": "composer audit --locked --abandoned=fail",
    "lint:style": "vendor/bin/phpcs -p --parallel=8",
    "fix:style": "vendor/bin/phpcbf --parallel=8 || true",
    "analyze:static": "vendor/bin/phpstan.phar analyse --memory-limit=512M",
    "test:unit": "vendor/bin/phpunit",
    "cache:clear": "@php scripts/clear-runtime-cache.php",
    "upgrade:inspect": "@php scripts/upgrade-inspect.php",
    "upgrade:apply": "@php scripts/upgrade-apply.php",
    "rector:check": "vendor/bin/rector process --dry-run",
    "rector:apply": "vendor/bin/rector process",
    "deps:outdated": "composer outdated --direct",
    "fix": [
      "@fix:style"
    ],
    "check": [
      "@check:composer",
      "@security:audit",
      "@lint:style",
      "@analyze:static",
      "@test:unit"
    ],
    "qa": [
      "@fix",
      "@check"
    ],
    "release:upgrade-package": "@php dev/scripts/build-upgrade-package.php",
    "release:install-package": "@php dev/scripts/build-install-package.php",
    "release:changelog:draft": "@php dev/scripts/changelog-draft.php",
    "release:changelog:check": "@php dev/scripts/changelog-draft.php --check"
  },
  "scripts-descriptions": {
    "check": "Read-only project quality gate for CI and pre-merge verification.",
    "qa": "Local convenience command: apply safe style fixes, then run the full read-only quality gate.",
    "fix": "Apply safe mechanical fixes only.",
    "rector:check": "Preview Rector changes; keep out of the default gate because Rector codemods require review.",
    "deps:outdated": "Show outdated direct Composer dependencies.",
    "cache:clear": "Clear OkayCMS runtime generated artifacts (compiled templates, compiled CSS/JS). Preserves license cache and dotfiles.",
    "upgrade:inspect": "Inspect an OkayCMS release upgrade package without mutating files or database state.",
    "upgrade:apply": "Apply an OkayCMS release upgrade package with preflight guardrails and reporting.",
    "release:install-package": "Build a production install archive for a new OkayCMS shop.",
    "release:changelog:draft": "Print a reviewable Keep a Changelog draft for commits since the latest tag.",
    "release:changelog:check": "Check whether CHANGELOG.md [Невипущено] likely covers commits since the latest tag."
  },
  "extra": {
    "patches": {
      "axy/sourcemap": {
        "Fix null array offset in Line::concat() for PHP 8.4+": "patches/axy-sourcemap-php85-null-array-offset.patch"
      }
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "policy": {
      "advisories": {
        "block": true,
        "audit": "fail"
      },
      "abandoned": {
        "audit": "fail"
      },
      "malware": {
        "block": true,
        "audit": "fail"
      }
    }
  }
}
