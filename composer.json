    "require": {
        "php": "~7.4.0 || ~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-SimpleXML": "*",
        "ext-XMLReader": "*",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",

        "gregwar/image": "^2.1",
        "smarty/smarty": "^4.3",
        "mobiledetect/mobiledetectlib": "^2.8",
        "phpmailer/phpmailer": "^6.9",
        "sabberworm/php-css-parser": "^8.6 || ^9.0",
        "matthiasmullie/minify": "^1.3.70",
        "bramus/router": "^1.6",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "monolog/monolog": "^2.9 || ^3.6",
        "aura/sqlquery": "^2.8 || ^3.0",
        "aura/sql": "^3.0 || ^4.0 || ^5.0 || ^6.0",
        "haydenpierce/class-finder": "^0.4 || ^0.5",
        "axy/sourcemap": "^0.1.5 || ^1.0",
        "giggsey/libphonenumber-for-php": "^8.13 || ^9.0",
        "rosell-dk/webp-convert": "^2.9",
        "psr/container": "^1.1 || ^2.0",

        "symfony/console": "^5.4 || ^6.4 || ^7.0",
        "symfony/process": "^5.4 || ^6.4 || ^7.0",
        "symfony/lock": "^5.4 || ^6.4 || ^7.0",

        "dragonmantank/cron-expression": "^3.3",

        "orhanerday/open-ai": "^5.0"
    },
    "require-dev": {
        "maximebf/debugbar": "^1.18",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "symfony/var-dumper": "^5.4 || ^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Okay\\": "Okay/",
            "Okay\\Admin\\": "backend/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
