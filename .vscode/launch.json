{
  "configurations": [
    {
      "name": "Listen for Xdebug",
      "type": "php",
      "request": "launch",
      "hostname": "0.0.0.0",
      "port": 9003,
      "pathMappings": {
        "/var/www/html": "${workspaceFolder}"
      },
      "preLaunchTask": "DDEV: Enable Xdebug",
      "postDebugTask": "DDEV: Disable Xdebug",
      "xdebugSettings": {
        "max_children": 128,
        "max_data": 1024,
        "show_hidden": 1
      }
    }
  ]
}
